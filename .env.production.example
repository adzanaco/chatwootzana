# ===================================
# Chatwoot Production Environment
# ===================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DATABASE=chatwoot_production

# Redis Configuration
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# Rails Configuration
RAILS_ENV=production
RACK_ENV=production
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
INSTALLATION_ENV=docker

# Security - IMPORTANT: Generate new secret!
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME_GENERATE_NEW_SECRET_KEY_BASE

# Application URLs
FRONTEND_URL=https://YOUR_DOMAIN.com
FORCE_SSL=true

# Features
ENABLE_ACCOUNT_SIGNUP=false
USE_INBOX_AVATAR_FOR_BOT=true

# Storage Configuration
ACTIVE_STORAGE_SERVICE=local
STORAGE_PATH=/app/storage

# Email Configuration (Required)
MAILER_SENDER_EMAIL=noreply@YOUR_DOMAIN.com
MAILER_INBOUND_EMAIL_DOMAIN=YOUR_DOMAIN.com

# SMTP Settings (Example for Gmail)
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_DOMAIN=YOUR_DOMAIN.com
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Alternative: SendGrid
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_DOMAIN=YOUR_DOMAIN.com
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true

# Optional: Social Login
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CALLBACK_URL=https://YOUR_DOMAIN.com/omniauth/google_oauth2/callback

# Facebook
# FB_APP_ID=
# FB_APP_SECRET=

# Optional: Cloud Storage (S3-compatible)
# ACTIVE_STORAGE_SERVICE=amazon
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Optional: AI Features
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: n8n Integration
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/chatwoot

# Optional: Analytics
# ANALYTICS_TOKEN=
# ANALYTICS_HOST=

# Optional: Sentry Error Tracking
# SENTRY_DSN=

# Optional: Direct Uploads
# DIRECT_UPLOADS_ENABLED=true

# System Limits
# Maximum number of accounts per installation
# ACCOUNT_LIMIT=

# Rate Limiting
# RACK_ATTACK_ENABLED=true

# Background Jobs
# SIDEKIQ_CONCURRENCY=10

# Webhook Settings
# WEBHOOK_TIMEOUT=30

# Integrations
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# WhatsApp (via Twilio)
# WHATSAPP_ACCOUNT_SID=
# WHATSAPP_AUTH_TOKEN=

# Telegram
# Leave empty initially, will be configured via UI

# Instagram
# IG_VERIFY_TOKEN=
# FB_APP_ID=
# FB_APP_SECRET=

# Twitter
# TWITTER_CONSUMER_KEY=
# TWITTER_CONSUMER_SECRET=

# Performance
# WEB_CONCURRENCY=2
# RAILS_MAX_THREADS=5
# DATABASE_POOL_SIZE=10